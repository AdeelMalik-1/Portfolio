# SERVER
PORT=5000
# Keep this as "development" for local work — it disables the strict
# production checks (CORS allow-list, rate limiting, startup JWT_SECRET
# check) so testing locally or from your phone isn't blocked.
# Set it to "production" only in your actual deployed server's environment
# variables (Render/Railway dashboard) — not in this local .env file.
NODE_ENV=development

# The exact URL(s) of your deployed frontend, comma-separated if more than
# one (e.g. a Vercel preview + production domain). Only these origins are
# allowed to call this API from a browser. Leave unset for local dev, where
# it defaults to http://localhost:5173
CLIENT_URL=https://your-portfolio.vercel.app

# MongoDB — required for login/signup (user accounts), optional for contact-message storage
MONGO_URI=YOUR_MONGODB_CONNECTION_STRING

# JWT — must be a long, random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this across projects, and never commit the real value.
JWT_SECRET=YOUR_LONG_RANDOM_SECRET_STRING

# EMAIL (required for the contact form to actually send you messages)
# For Gmail: turn on 2-Step Verification, then create an "App Password"
# at https://myaccount.google.com/apppasswords and paste it below.
EMAIL_SERVICE=gmail
EMAIL_USER=YOUR_EMAIL@gmail.com
EMAIL_PASS=YOUR_16_CHAR_APP_PASSWORD
EMAIL_TO=YOUR_EMAIL@gmail.com
